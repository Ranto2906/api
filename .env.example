# Configuration de l'application - Mode Hybride Firebase/PostgreSQL

# ================================
# Base de Données PostgreSQL (Local)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travaux_routiers
DB_USER=postgres
DB_PASSWORD=your_password
DB_MAX_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30000

# ================================
# Firebase (Cloud)
# ================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ================================
# Configuration du Mode Hybride
# ================================
# Mode de fonctionnement : hybrid | firebase-only | postgres-only
SYNC_MODE=hybrid

# Intervalle de vérification Firebase (en secondes)
FIREBASE_CHECK_INTERVAL=30

# Tentatives automatiques de reconnexion
AUTO_RECONNECT_ATTEMPTS=3
RECONNECT_DELAY=5000

# Synchronisation automatique après reconnexion
AUTO_SYNC_ON_RECONNECT=true

# Timeout pour les opérations Firebase (en ms)
FIREBASE_TIMEOUT=10000

# ================================
# Configuration des Sessions
# ================================
JWT_SECRET=your-super-secure-jwt-secret-key
SESSION_DURATION=3600
REFRESH_TOKEN_DURATION=86400

# ================================
# Sécurité
# ================================
# Nombre max de tentatives de connexion
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# CORS Origins autorisées
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ================================
# Logging et Monitoring
# ================================
# Niveau de log : error | warn | info | debug
LOG_LEVEL=info

# Activer les logs de synchronisation
ENABLE_SYNC_LOGGING=true

# Durée de conservation des logs de sync (en jours)
SYNC_LOG_RETENTION_DAYS=30

# ================================
# Performance et Optimisation
# ================================
# Taille des batch pour la synchronisation
SYNC_BATCH_SIZE=100

# Timeout pour les requêtes de synchronisation (en ms)
SYNC_TIMEOUT=30000

# Cache des données Firebase (en secondes)
FIREBASE_CACHE_DURATION=300

# ================================
# Configuration du Serveur
# ================================
PORT=3000
NODE_ENV=development

# API Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

# ================================
# Configuration des Emails
# ================================
# Service email: gmail, outlook, yahoo, ou autre
EMAIL_SERVICE=gmail

# Compte email pour l'envoi
EMAIL_USER=your-email@gmail.com

# Mot de passe d'application (pas le mot de passe du compte!)
# Pour Gmail: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=http://localhost:5173

# ================================
# Configuration Mobile (optionnel)
# ================================
# Push notifications
# FCM_SERVER_KEY=your-fcm-server-key

# ================================
# Backup et Archivage (optionnel)
# ================================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=7
# BACKUP_PATH=./backups

# ================================
# Configuration de Développement
# ================================
# Activer les logs détaillés en développement
DEBUG_MODE=true

# Simuler la perte de connexion (pour tests)
SIMULATE_OFFLINE=false

# Délai de simulation de latence (en ms)
SIMULATE_LATENCY=0# Firebase Web API Key (from Firebase Console > Project Settings > General)
FIREBASE_API_KEY=AIzaSyAyyX8ZDCV6nBooeksTO54xvEFDboQzfQw
