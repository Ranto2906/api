{
  "name": "travaux-routiers-api",
  "version": "1.0.0",
  "description": "API REST - Gestion des travaux routiers (TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "concurrently \"tsc -w\" \"nodemon dist/server.js\"",
    "type-check": "tsc --noEmit",
    "firebase-setup": "ts-node src/scripts/firebaseSetup.ts",
    "firebase-init": "ts-node src/scripts/firebaseSetup.ts init",
    "firebase-status": "ts-node src/scripts/firebaseSetup.ts status",
    "firebase-reset": "ts-node src/scripts/firebaseSetup.ts reset",
    "firebase-sample": "ts-node src/scripts/firebaseSetup.ts sample",
    "firebase-clear": "ts-node src/scripts/firebaseSetup.ts clear"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
